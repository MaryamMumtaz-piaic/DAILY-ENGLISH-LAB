FASTAPI_ENV=development

# Internal security
INTERNAL_API_KEY=change-me-to-a-long-random-secret

# LLM
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o

# STT (leave blank to reuse LLM_API_KEY)
STT_PROVIDER=openai-whisper
STT_API_KEY=

# TTS (leave blank to reuse LLM_API_KEY)
TTS_PROVIDER=openai-tts
TTS_API_KEY=
TTS_VOICE=alloy
