# =============================================================
# Daily English Lab — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env with real credentials.
# =============================================================

# -------------------------------------------------------------
# DATABASE
# -------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/daily_english_lab

# -------------------------------------------------------------
# REDIS
# -------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# -------------------------------------------------------------
# JWT AUTHENTICATION
# Minimum 64 characters, use a cryptographic random generator.
# Generate: openssl rand -hex 64
# -------------------------------------------------------------
JWT_ACCESS_SECRET=your_access_token_secret_minimum_64_characters
JWT_REFRESH_SECRET=your_refresh_token_secret_minimum_64_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -------------------------------------------------------------
# FASTAPI INTERNAL SERVICE
# Used by NestJS to communicate with the AI service.
# Never expose these to the browser.
# -------------------------------------------------------------
FASTAPI_INTERNAL_URL=http://localhost:8000
FASTAPI_INTERNAL_API_KEY=your_internal_api_key_here

# -------------------------------------------------------------
# LLM PROVIDER
# Provider: openai | anthropic | groq
# -------------------------------------------------------------
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-llm-api-key-here
LLM_MODEL=gpt-4o

# -------------------------------------------------------------
# SPEECH-TO-TEXT (STT)
# Provider: openai-whisper | deepgram | google
# -------------------------------------------------------------
STT_PROVIDER=openai-whisper
STT_API_KEY=sk-your-stt-api-key-here

# -------------------------------------------------------------
# TEXT-TO-SPEECH (TTS)
# Provider: openai-tts | elevenlabs | google
# -------------------------------------------------------------
TTS_PROVIDER=openai-tts
TTS_API_KEY=sk-your-tts-api-key-here
TTS_VOICE=alloy

# -------------------------------------------------------------
# OBJECT STORAGE (S3-compatible)
# Local dev: use MinIO (included in docker-compose)
# Production: AWS S3, Cloudflare R2, DigitalOcean Spaces
# -------------------------------------------------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=daily-english-lab-audio
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_URL=http://localhost:9000

# Audio file retention: number of days (0 = keep forever)
AUDIO_RETENTION_DAYS=30

# -------------------------------------------------------------
# NESTJS APPLICATION
# -------------------------------------------------------------
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# -------------------------------------------------------------
# FASTAPI APPLICATION
# -------------------------------------------------------------
FASTAPI_ENV=development
FASTAPI_PORT=8000
FASTAPI_WORKERS=1

# -------------------------------------------------------------
# RATE LIMITING
# -------------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=60

# Stricter limit for AI-powered endpoints
AI_THROTTLE_TTL=60
AI_THROTTLE_LIMIT=10

# -------------------------------------------------------------
# NEXT.JS FRONTEND
# Only NEXT_PUBLIC_ prefixed variables are exposed to the browser.
# Never add secrets with the NEXT_PUBLIC_ prefix.
# -------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# -------------------------------------------------------------
# OBSERVABILITY (optional)
# -------------------------------------------------------------
LOG_LEVEL=debug
SENTRY_DSN=
